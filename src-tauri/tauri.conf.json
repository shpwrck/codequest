{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "code-quest-advance",
  "version": "0.2.3",
  "identifier": "com.jskrzype.code-quest-advance",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CODE QUEST ADVANCE",
        "width": 1240,
        "height": 760,
        "minWidth": 600,
        "minHeight": 376,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
